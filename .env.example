# LawBite environment template.
# Copy to .env.local and fill in real values. Never commit .env.local.

# ---------------------------------------------------------------- required ---
# PostgreSQL connection string (Neon). Used by Better Auth and Kysely.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Better Auth. Generate the secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-32-byte-random-string
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# OAuth apps (Google Cloud Console / GitHub Developer Settings)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ------------------------------------------------------------ AI providers ---
# Inception Labs is the default provider; NVIDIA NIM is the fallback.
# At least one key is required. Set both for full failover.
INCEPTION_API_KEY=
NVIDIA_API_KEY=

# --------------------------------------------------------------- optional ---
# Real-time legal news and web search augmentation.
TAVILY_API_KEY=

# S3 knowledge base (157+ bare acts) and case document uploads.
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=lawbite-app-storage

# Transactional email for legal notices (SMTP).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="LawBite" <no-reply@example.com>

# Extra allowed origins for Better Auth (comma separated).
TRUSTED_ORIGINS=

# Comma separated admin emails for /admin and /api/admin.
ADMIN_EMAILS=

# ------------------------------------------------------- tuning overrides ---
# Chat latency and provider failover. Defaults are fine for production.
# CHAT_REASONING_EFFORT=instant
# CHAT_REALTIME=1
# CHAT_PROVIDER_CONNECT_TIMEOUT_MS=20000
# CHAT_FIRST_CONTENT_TIMEOUT_MS=20000
# CHAT_RATE_LIMIT_RETRIES=3
# CHAT_RATE_LIMIT_BACKOFF_MS=300,800,1600
